# Contact form (src/app/api/contact/route.js)
# Copy this file to .env.local and fill it in. On Vercel, add the same three
# variables under Project → Settings → Environment Variables.

# A SEPARATE Gmail account that sends the form messages — not your main one.
# Because it's a different account, messages arrive as "Jane Cooper via
# Portfolio" with this account's profile photo, instead of looking like you
# emailed yourself. Give it a portfolio-style name and photo (e.g. your MC logo).
CONTACT_SMTP_USER=your.portfolio.inbox@gmail.com

# A 16-character Google App Password for that sender account (not its normal
# password). Needs 2-Step Verification on: myaccount.google.com/apppasswords
CONTACT_SMTP_PASS=abcd efgh ijkl mnop

# Where messages are delivered: your real inbox.
CONTACT_TO=markchristiannaval07@gmail.com

# Optional — only if you send through a provider other than Gmail.
# CONTACT_SMTP_HOST=smtp.example.com
# CONTACT_SMTP_PORT=465
